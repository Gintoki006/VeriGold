# Database (PostgreSQL — use asyncpg driver URL for SQLAlchemy async)
DATABASE_URL=postgresql://user:password@host:5432/verigold

# Auth
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Borrower Privacy (generate with: openssl rand -hex 32)
BORROWER_HASH_KEY=change-me-in-production-use-openssl-rand-hex-32

# Fabric
FABRIC_GATEWAY_URL=localhost:7051
FABRIC_CA_URL=http://localhost:7054
FABRIC_MSP_CONFIG_PATH=/app/fabric/crypto-config
FABRIC_CHANNEL_NAME=mychannel
CHAINCODE_NAME=verigold
FABRIC_ORG_MSP_ID=Org1MSP

# Fabric bridge script (WSL path to cc-client.sh)
FABRIC_BRIDGE_SCRIPT=/mnt/d/VeriGold/fabric/network/cc-client.sh

# Redis
REDIS_URL=redis://localhost:6379

# AI / LLM
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# ZK
ZK_CIRCUIT_PATH=/app/zk/circuits/exposure_threshold
ZK_PROOF_FALLBACK=false

# Noir/Nargo binary path (WSL or native)
NARGO_PATH=/home/user/.nargo/bin/nargo

# Rate Limiting
BORROWER_SEARCH_RATE_LIMIT=10

# CORS — set FRONTEND_URL to your deployed frontend (e.g. https://verigold.vercel.app)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo mode — set to true ONLY for local demos; NEVER in production
DEMO_MODE=false
